<?xml version="1.0" encoding="utf-8"?>
<!-- "Les trois têtes": each dog of the logo is a button; the card takes the active state's color. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_unknown"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/col_off"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="80dp">

            <ImageView
                android:id="@+id/glow_off"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:src="@drawable/widget_glow"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/head_on_off"
                android:layout_width="34dp"
                android:layout_height="61dp"
                android:layout_gravity="center"
                android:contentDescription="Off"
                android:src="@drawable/ic_dog_head"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/head_off_off"
                android:layout_width="22dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:alpha="0.5"
                android:contentDescription="Off"
                android:src="@drawable/ic_dog_head" />
        </FrameLayout>

        <TextView
            android:id="@+id/label_off"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Off"
            android:textColor="@color/widget_dim"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/col_night"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="80dp">

            <ImageView
                android:id="@+id/glow_night"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:src="@drawable/widget_glow"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/head_on_night"
                android:layout_width="34dp"
                android:layout_height="61dp"
                android:layout_gravity="center"
                android:contentDescription="Nuit"
                android:src="@drawable/ic_dog_head"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/head_off_night"
                android:layout_width="22dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:alpha="0.5"
                android:contentDescription="Nuit"
                android:src="@drawable/ic_dog_head" />
        </FrameLayout>

        <TextView
            android:id="@+id/label_night"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Nuit"
            android:textColor="@color/widget_dim"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/col_on"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="80dp">

            <ImageView
                android:id="@+id/glow_on"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:src="@drawable/widget_glow"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/head_on_on"
                android:layout_width="34dp"
                android:layout_height="61dp"
                android:layout_gravity="center"
                android:contentDescription="Totale"
                android:src="@drawable/ic_dog_head"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/head_off_on"
                android:layout_width="22dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:alpha="0.5"
                android:contentDescription="Totale"
                android:src="@drawable/ic_dog_head" />
        </FrameLayout>

        <TextView
            android:id="@+id/label_on"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Totale"
            android:textColor="@color/widget_dim"
            android:textSize="12sp" />
    </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="Cerbère"
        android:textColor="@color/widget_dim"
        android:textSize="11sp" />
</LinearLayout>
