<?xml version="1.0" encoding="utf-8"?>
<!-- One-row version of "les trois têtes": same ids as widget_alarm.xml, so the same code fills both. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_unknown"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingTop="4dp"
    android:paddingEnd="6dp"
    android:paddingBottom="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/col_off"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/glow_off"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:src="@drawable/widget_pill_lit"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/head_on_off"
                    android:layout_width="12dp"
                    android:layout_height="22dp"
                    android:contentDescription="Off"
                    android:src="@drawable/ic_dog_head"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/head_off_off"
                    android:layout_width="9dp"
                    android:layout_height="17dp"
                    android:alpha="0.5"
                    android:contentDescription="Off"
                    android:src="@drawable/ic_dog_head" />

                <TextView
                    android:id="@+id/label_off"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="Off"
                    android:textColor="@color/widget_dim"
                    android:textSize="11sp" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/col_night"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="3dp">

            <ImageView
                android:id="@+id/glow_night"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:src="@drawable/widget_pill_lit"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/head_on_night"
                    android:layout_width="12dp"
                    android:layout_height="22dp"
                    android:contentDescription="Nuit"
                    android:src="@drawable/ic_dog_head"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/head_off_night"
                    android:layout_width="9dp"
                    android:layout_height="17dp"
                    android:alpha="0.5"
                    android:contentDescription="Nuit"
                    android:src="@drawable/ic_dog_head" />

                <TextView
                    android:id="@+id/label_night"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="Nuit"
                    android:textColor="@color/widget_dim"
                    android:textSize="11sp" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/col_on"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="3dp">

            <ImageView
                android:id="@+id/glow_on"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:src="@drawable/widget_pill_lit"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/head_on_on"
                    android:layout_width="12dp"
                    android:layout_height="22dp"
                    android:contentDescription="Totale"
                    android:src="@drawable/ic_dog_head"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/head_off_on"
                    android:layout_width="9dp"
                    android:layout_height="17dp"
                    android:alpha="0.5"
                    android:contentDescription="Totale"
                    android:src="@drawable/ic_dog_head" />

                <TextView
                    android:id="@+id/label_on"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="Totale"
                    android:textColor="@color/widget_dim"
                    android:textSize="11sp" />
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="Cerbère"
        android:textColor="@color/widget_dim"
        android:textSize="9sp" />
</LinearLayout>
